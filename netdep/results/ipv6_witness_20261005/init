#!/bin/sh
set -x
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /lib/modules
echo === IPv6 module-retained attempt: ipv6.ko not loaded ===
cat /proc/cmdline
for m in bridge br_netfilter nf_defrag_ipv6 nf_conntrack_ipv6 nf_nat_ipv6 ip6_tables xt_nat ip6table_nat; do
  insmod /lib/modules/$m.ko 2>&1 || echo insmod-$m-failed
 done
ip link add br0 type bridge
ip link add name veth0 type veth peer name veth1
ip link set veth0 master br0
ip link set veth1 master br0
ip link set br0 up
ip link set veth0 up
ip link set veth1 up
ip6tables -t nat -F PREROUTING
ip6tables -t nat -A PREROUTING -d 2001:db8::1 -j DNAT --to-destination 2001:db8::2
ip6tables -t nat -vnL PREROUTING
/send_ipv6 veth1 2001:db8::10 2001:db8::1
sleep 2
dmesg | tail -120
echo === TRIGGER NOT REACHED ===
poweroff -f
sleep 5